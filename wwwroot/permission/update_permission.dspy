
ns = params_kw.copy()
for k,v in ns.items():
	if v == 'NaN' or v == 'null':
		ns[k] = None




db = DBPools()
dbname = get_module_dbname('rbac')
async with db.sqlorContext(dbname) as sor:

	r = await sor.U('permission', ns)
	debug('update success');
	return {
		"widgettype":"Message",
		"options":{
			"title":"Update Success",
			"cwidth":16,
			"cheight":9,
			"timeout":3,
			"message":"ok"
		} 
	}
		
return {
	"widgettype":"Error",
	"options":{
		"title":"Update Error",
		"cwidth":16,
		"cheight":9,
		"timeout":3,
		"message":"failed"
	}
}