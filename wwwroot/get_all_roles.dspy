async with get_sor_context(request._run_ns, 'rbac') as sor:
	recs = sor.R('role', {})
	d = []
	for r in recs:
		if r.id in ['anonymous', 'any', 'logined']:
			d.append(r.id)
		else:
			d.append(f'{r.orgtypeid}.{r.name}')
			d.append(f'{r.orgtypeid}.*')
			d.append(f'*.{r.name}')
		d = sorted(list(set(d)))
		return d
	return []
