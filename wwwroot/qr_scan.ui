{
    "widgettype": "QRCodeScan",
    "options": {},
    "binds": [
        {
            "wid": "self",
            "event": "recognized",
            "actiontype": "script",
            "target": "self",
            "script": "if(event && event.params && event.params.text) window.open(event.params.text, '_blank');"
        },
        {
            "wid": "self",
            "event": "recognized",
            "actiontype": "script",
            "target": "-@PopupWindow",
            "script": "this.dismiss()"
        }
    ]
}
