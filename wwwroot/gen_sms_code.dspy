phone = params_kw.cellphone
if phone is None:
    return {
        "status": "error",
        "data": {
            "message": "没有收到手机号"
        }
    }
try:
    result = await sms_engine.generate_sms_code(phone)
    if result is None:
        return {
            "status": "error",
            "data": {
                "message": "短信发送失败，请稍后重试"
            }
        }
    code_id, code = result
    debug(f'sms sent: code_id={code_id}, phone={phone}')
    return {
        "status": "ok",
        "data": {
            "message": "验证码已发送",
            "key": code_id
        }
    }
except Exception as e:
    debug(f'gen_sms_code error: {e}')
    exception(f'gen_sms_code error for {phone}: {e}')
    return {
        "status": "error",
        "data": {
            "message": f"发送验证码出错: {e}"
        }
    }
